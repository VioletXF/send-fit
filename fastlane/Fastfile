require "shellwords"

default_platform(:ios)

platform :ios do
  before_all do
    ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] ||= "120"
  end

  desc "Run the full SendFit simulator test suite"
  lane :test do
    sh("xcodegen generate")
    scan(
      project: "SendFit.xcodeproj",
      scheme: "SendFit",
      devices: [ENV.fetch("SIMULATOR_NAME", "iPhone 17 Pro")],
      clean: false
    )
  end

  desc "Create the SendFit identifier and App Store Connect app record"
  lane :create_app do
    produce(
      app_identifier: ENV.fetch("APP_IDENTIFIER", "com.sendfit.app"),
      app_name: ENV.fetch("APP_STORE_NAME", ENV.fetch("APP_NAME", "SendFit")),
      sku: ENV.fetch("APP_STORE_SKU", "sendfit-ios"),
      language: ENV.fetch("APP_STORE_PRIMARY_LANGUAGE", "English"),
      platform: "ios",
      skip_itc: false,
      skip_devcenter: false
    )
  end

  desc "Build an ad-hoc IPA and distribute it with Firebase App Distribution"
  lane :firebase do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_filepath: ENV.fetch("APP_STORE_CONNECT_KEY_PATH")
    )
    match(type: "adhoc", api_key: api_key)
    build_app(
      project: "SendFit.xcodeproj",
      scheme: "SendFit",
      export_method: "ad-hoc",
      xcargs: "ADMOB_APP_ID=#{Shellwords.escape(ENV.fetch('ADMOB_APP_ID'))} ADMOB_BANNER_AD_UNIT_ID=#{Shellwords.escape(ENV.fetch('ADMOB_BANNER_AD_UNIT_ID'))} ADMOB_INTERSTITIAL_AD_UNIT_ID=#{Shellwords.escape(ENV.fetch('ADMOB_INTERSTITIAL_AD_UNIT_ID'))}"
    )
    firebase_app_distribution(
      app: ENV.fetch("FIREBASE_IOS_APP_ID"),
      groups: ENV.fetch("FIREBASE_APP_DISTRIBUTION_GROUPS", "internal"),
      service_credentials_json_data: ENV.fetch("FIREBASE_SERVICE_CREDENTIALS_JSON"),
      release_notes: ENV.fetch("FIREBASE_APP_DISTRIBUTION_RELEASE_NOTES", "SendFit ad-hoc build")
    )
  end

  desc "Archive and upload a signed production build to TestFlight"
  lane :testflight do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_filepath: ENV.fetch("APP_STORE_CONNECT_KEY_PATH")
    )
    match(type: "appstore", api_key: api_key)
    build_app(
      project: "SendFit.xcodeproj",
      scheme: "SendFit",
      export_method: "app-store",
      xcargs: "ADMOB_APP_ID=#{Shellwords.escape(ENV.fetch('ADMOB_APP_ID'))} ADMOB_BANNER_AD_UNIT_ID=#{Shellwords.escape(ENV.fetch('ADMOB_BANNER_AD_UNIT_ID'))} ADMOB_INTERSTITIAL_AD_UNIT_ID=#{Shellwords.escape(ENV.fetch('ADMOB_INTERSTITIAL_AD_UNIT_ID'))}"
    )
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
