# Local release-integration template. Copy to .env and fill values before archiving.
ADMOB_APP_ID=
ADMOB_BANNER_AD_UNIT_ID=
ADMOB_INTERSTITIAL_AD_UNIT_ID=
# Create a Google Cloud Desktop OAuth client with the AdMob API enabled, then
# run `bundle exec ruby scripts/provision_admob.rb authorize` followed by
# `bundle exec ruby scripts/provision_admob.rb provision`.
ADMOB_OAUTH_CLIENT_ID=
ADMOB_OAUTH_CLIENT_SECRET=
ADMOB_OAUTH_REFRESH_TOKEN=
ADMOB_PUBLISHER_ACCOUNT=
ADMOB_APP_DISPLAY_NAME=SendFit
ADMOB_BANNER_DISPLAY_NAME=SendFit Compression Banner
ADMOB_INTERSTITIAL_DISPLAY_NAME=SendFit Result Interstitial
APPLE_DEVELOPMENT_TEAM=
APP_IDENTIFIER=com.sendfit.app
APP_NAME=SendFit
APP_STORE_NAME=SendFit: Video Compressor
APP_STORE_SKU=sendfit-ios
APP_STORE_PRIMARY_LANGUAGE=English
# App Store Connect provider/team values are only needed if your Apple Account
# belongs to more than one App Store Connect provider or team.
APP_STORE_CONNECT_TEAM_ID=
APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_KEY_PATH=
# AsoBMaShow-compatible Match transport; leave this blank only to use the
# Matchfile default repository. Never commit its Basic authorization value.
GIT_BASIC_AUTHORIZATION=
MATCH_GIT_URL=
MATCH_PASSWORD=
MATCH_KEYCHAIN_PASSWORD=
FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD=
FASTLANE_USER=
FIREBASE_IOS_APP_ID=
FIREBASE_APP_DISTRIBUTION_GROUPS=internal
FIREBASE_SERVICE_CREDENTIALS_JSON=
FIREBASE_APP_DISTRIBUTION_RELEASE_NOTES=
